# Fail on an npm older than engines.npm instead of writing a lock file the
# container's npm rejects. node:24-alpine ships 11.19.0; an older npm re-hoists
# @tailwindcss/oxide-wasm32-wasi's bundled @emnapi/* packages, and `npm ci` in the
# image then dies with "Missing: @emnapi/core from lock file".
engine-strict=true
